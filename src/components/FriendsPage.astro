---
import { Icon } from "astro-icon/components";
import { friendLinks } from "@/data/friends";

interface Props {
	lang?: string;
}

const { lang = "zh_CN" } = Astro.props;
const isEnglish = lang === "en_US";

const copyFields = isEnglish
	? [
			{ label: "Name", value: "Kagura iYoRoy's Develop Diary" },
			{ label: "Link", value: "https://blog.iyoroy.cn" },
			{
				label: "Description",
				value: "May all things in the world be treated with tenderness.",
			},
			{
				label: "Round avatar (Markdown)",
				value:
					"![Kagura iYoRoy's Develop Diary](https://www.iyoroy.cn/friends/avatars/iyoroy-round.png)",
			},
			{
				label: "Square avatar (Markdown)",
				value:
					"![Kagura iYoRoy's Develop Diary](https://www.iyoroy.cn/friends/avatars/iyoroy-square.jpg)",
			},
		]
	: [
			{ label: "名称", value: "悠笙の开发日记" },
			{ label: "链接", value: "https://blog.iyoroy.cn" },
			{ label: "简介", value: "愿世间万物都能被温柔以待" },
			{
				label: "圆形头像（Markdown）",
				value:
					"![悠笙の开发日记](https://www.iyoroy.cn/friends/avatars/iyoroy-round.png)",
			},
			{
				label: "方形头像（Markdown）",
				value:
					"![悠笙の开发日记](https://www.iyoroy.cn/friends/avatars/iyoroy-square.jpg)",
			},
		];

const labels = isEnglish
	? {
			profileTitle: "My friend link",
			profileDescription: "Copy any field below when adding this site to your friend links.",
			friendsTitle: "Other friend links",
			visit: "Visit",
			copy: "Copy",
			copied: "Copied",
		}
	: {
			profileTitle: "我的友链资料",
			profileDescription: "添加友链时可以直接复制下面任意一项。",
			friendsTitle: "其他友链",
			visit: "访问站点",
			copy: "复制",
			copied: "已复制",
		};
---

<div class="friends-page prose dark:prose-invert prose-base !max-w-none" data-pagefind-body>
	<section class="friends-profile">
		<div class="friends-section-heading">
			<h1>{labels.profileTitle}</h1>
			<p>{labels.profileDescription}</p>
		</div>

		<div class="friends-copy-grid">
			{copyFields.map((field) => (
				<div class="friends-copy-field">
					<div class="friends-copy-label">{field.label}</div>
					<div class="friends-code-wrap">
						<pre><code>{field.value}</code></pre>
						<button
							type="button"
							class="friends-copy-button"
							data-copy-value={field.value}
							data-copy-label={labels.copy}
							data-copied-label={labels.copied}
							title={labels.copy}
							aria-label={`${labels.copy}: ${field.label}`}
						>
							<Icon name="material-symbols:content-copy-outline" class="copy-icon" aria-hidden="true" />
							<Icon name="material-symbols:check-rounded" class="copied-icon" aria-hidden="true" />
							<span class="sr-only">{labels.copy}</span>
						</button>
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="friends-directory">
		<div class="friends-section-heading">
			<h2>{labels.friendsTitle}</h2>
		</div>

		<div class="friends-list">
			{friendLinks.map((friend) => (
				<article class="friend-item">
					<img class="friend-avatar" src={friend.avatar} alt={`${friend.name} avatar`} loading="lazy" />
					<div class="friend-info">
						<a class="friend-name" href={friend.url} target="_blank" rel="noopener noreferrer">
							{friend.name}
						</a>
						<p class="friend-url">{friend.url}</p>
						<p class="friend-description">{friend.description}</p>
					</div>
					<a
						class="friend-visit"
						href={friend.url}
						target="_blank"
						rel="noopener noreferrer"
						title={labels.visit}
						aria-label={`${labels.visit}: ${friend.name}`}
					>
						<Icon name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" />
					</a>
				</article>
			))}
		</div>
	</section>
</div>

<script>
	const copyText = async (button: HTMLButtonElement) => {
		const value = button.dataset.copyValue;
		if (!value) return;

		try {
			await navigator.clipboard.writeText(value);
		} catch {
			return;
		}

		button.classList.add("is-copied");
		button.title = button.dataset.copiedLabel ?? "Copied";
		window.setTimeout(() => {
			button.classList.remove("is-copied");
			button.title = button.dataset.copyLabel ?? "Copy";
		}, 1400);
	};

	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;
		const button = target.closest<HTMLButtonElement>(".friends-copy-button");
		if (button) void copyText(button);
	});
</script>

<style>
	.friends-page {
		color: var(--tw-prose-body);
	}

	.friends-profile {
		padding-bottom: 2rem;
		border-bottom: 1px dashed var(--line-divider);
	}

	.friends-directory {
		padding-top: 2rem;
	}

	.friends-section-heading {
		margin-bottom: 1.25rem;
	}

	.friends-section-heading h1,
	.friends-section-heading h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--tw-prose-headings);
	}

	.friends-section-heading h1::before,
	.friends-section-heading h2::before {
		content: "";
		display: inline-block;
		width: 0.25rem;
		height: 1.25rem;
		margin-right: 0.75rem;
		border-radius: 999px;
		background: var(--primary);
		vertical-align: -0.12rem;
	}

	.friends-section-heading p {
		margin: 0.65rem 0 0;
		color: var(--tw-prose-body);
		opacity: 0.7;
	}

	.friends-copy-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.friends-copy-field {
		min-width: 0;
	}

	.friends-copy-label {
		margin-bottom: 0.4rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--tw-prose-headings);
	}

	.friends-code-wrap {
		position: relative;
	}

	.friends-code-wrap pre {
		min-height: 3rem;
		margin: 0;
		padding: 0.75rem 3rem 0.75rem 0.9rem;
		overflow-x: auto;
		border: 1px solid var(--line-divider);
		border-radius: 0.65rem;
		background: var(--codeblock-bg);
		color: var(--tw-prose-code);
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.8125rem;
		line-height: 1.5;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.friends-code-wrap code {
		padding: 0;
		background: transparent;
		color: inherit;
	}

	.friends-copy-button {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.5rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		cursor: pointer;
		transition: background-color 0.2s, color 0.2s, transform 0.2s;
	}

	.friends-copy-button:hover {
		background: var(--btn-regular-bg-hover);
		color: var(--primary);
	}

	.friends-copy-button:active {
		transform: scale(0.9);
	}

	.friends-copy-button .copied-icon,
	.friends-copy-button.is-copied .copy-icon {
		display: none;
	}

	.friends-copy-button.is-copied {
		background: var(--primary);
		color: var(--deep-text);
	}

	.friends-copy-button.is-copied .copied-icon {
		display: block;
	}

	.friends-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1.5rem;
	}

	.friend-item {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr) auto;
		gap: 0.9rem;
		align-items: center;
		min-width: 0;
		padding: 1rem 0;
		border-top: 1px dashed var(--line-divider);
	}

	.friend-avatar {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 0.85rem;
		object-fit: cover;
		background: var(--btn-regular-bg);
	}

	.friend-info {
		min-width: 0;
	}

	.friend-name {
		display: inline-block;
		max-width: 100%;
		overflow: hidden;
		color: var(--tw-prose-headings);
		font-size: 1rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.friend-name:hover {
		color: var(--primary);
	}

	.friend-url,
	.friend-description {
		margin: 0.2rem 0 0;
		overflow: hidden;
		font-size: 0.8rem;
		line-height: 1.45;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.friend-url {
		color: var(--primary);
	}

	.friend-description {
		color: var(--tw-prose-body);
		opacity: 0.7;
	}

	.friend-visit {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.6rem;
		color: var(--primary);
		transition: background-color 0.2s, transform 0.2s;
	}

	.friend-visit:hover {
		background: var(--btn-plain-bg-hover);
	}

	.friend-visit:active {
		transform: scale(0.9);
	}

	@media (max-width: 767px) {
		.friends-copy-grid,
		.friends-list {
			grid-template-columns: minmax(0, 1fr);
		}

		.friends-copy-grid {
			gap: 0.85rem;
		}
	}
</style>
