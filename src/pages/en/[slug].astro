---
import { getCollection, render } from "astro:content";
import FriendsPage from "@components/FriendsPage.astro";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const pages = await getCollection("spec");
	return pages
		.filter((page) => page.data.locale === "en-US" && page.data.routeSlug)
		.map((page) => ({
			params: { slug: page.data.routeSlug },
			props: { page },
		}));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<MainGridLayout title={page.data.title} lang={page.data.lang}>
	{page.data.routeSlug === "friends" ? (
		<div class="card-base px-6 py-6 md:px-9 onload-animation">
			<FriendsPage lang={page.data.lang} />
		</div>
	) : (
		<div class="card-base px-9 py-6 onload-animation">
			<Markdown class="mt-2"><Content /></Markdown>
		</div>
	)}
</MainGridLayout>
